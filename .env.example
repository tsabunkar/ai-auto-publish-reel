# =============================================================================
# AI Content Automation Platform — Environment Variables
# =============================================================================

# --- AWS Configuration ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- S3 ---
CONTENT_BUCKET=ai-content-automation-{environment}

# --- Orchestrator Lambda ---
RSS_FEED_URLS=https://feeds.hbr.org/harvardbusiness,https://www.forbes.com/leadership/feed/
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
POLLY_VOICE_ID=Matthew
JOB_QUEUE_TOPIC=reel/generate

# --- MacBook Controller ---
IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
WORKER_SSH_HOST=worker.tailnet.ts.net
WORKER_GENERATE_SCRIPT=/home/worker/generate.py
WORKER_PROMPT_DIR=/tmp
WORKER_OUTPUT_DIR=/tmp
WORKER_LOG_DIR=/home/worker/logs
LOCAL_ARTIFACT_DIR=./artifacts
LOCAL_LOG_DIR=./logs
SSH_TIMEOUT_SECONDS=3600
RSYNC_TIMEOUT_SECONDS=300

# --- Publisher Lambda ---
INSTAGRAM_SECRET_ID=instagram-credentials
LINKEDIN_SECRET_ID=linkedin-credentials
YOUTUBE_SECRET_ID=youtube-credentials

# --- Secrets (social API credentials) ---
# These are stored in AWS Secrets Manager, NOT in this file.
# The .env.example documents the expected secret structure:
#
# instagram-credentials:
#   {"access_token": "...", "ig_user_id": "..."}
#
# linkedin-credentials:
#   {"access_token": "...", "organization_urn": "urn:li:organization:..."}
#
# youtube-credentials:
#   {"access_token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
